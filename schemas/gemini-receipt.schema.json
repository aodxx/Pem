{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aodxx/Pem/schemas/gemini-receipt.schema.json",
  "title": "Palm Weighing Receipt Extraction",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "documentType": {
      "type": "string",
      "enum": [
        "PALM_WEIGHING_RECEIPT",
        "UNKNOWN"
      ]
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "receiptNumber": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "saleDate": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "timeIn": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "timeOut": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "buyerName": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "branch": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "address": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "phone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "customerCode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "customerName": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "vehiclePlate": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "productCode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "productName": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "receiptNumber",
        "saleDate",
        "timeIn",
        "timeOut",
        "buyerName",
        "branch",
        "address",
        "phone",
        "customerCode",
        "customerName",
        "vehiclePlate",
        "productCode",
        "productName"
      ]
    },
    "weights": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "grossWeightKg": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "tareWeightKg": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "netWeightKg": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "deductionWeightKg": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "payableWeightKg": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "grossWeightKg",
        "tareWeightKg",
        "netWeightKg",
        "deductionWeightKg",
        "payableWeightKg"
      ]
    },
    "pricing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pricePerKg": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "grossAmount": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "totalDeduction": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "netAmount": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "currency": {
          "type": "string",
          "enum": [
            "THB"
          ]
        }
      },
      "required": [
        "pricePerKg",
        "grossAmount",
        "totalDeduction",
        "netAmount",
        "currency"
      ]
    },
    "deductions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "WEIGHT",
              "PERCENT",
              "CONTAMINATION",
              "TRANSPORT",
              "LABOR",
              "SERVICE",
              "OTHER"
            ]
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "quantity": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "unit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "rate": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "amount": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "type",
          "description",
          "quantity",
          "unit",
          "rate",
          "amount"
        ]
      }
    },
    "notes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "printedNotes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "handwrittenNotes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "stampPresent": {
          "type": "boolean"
        },
        "signaturePresent": {
          "type": "boolean"
        }
      },
      "required": [
        "printedNotes",
        "handwrittenNotes",
        "stampPresent",
        "signaturePresent"
      ]
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "overallConfidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "fieldConfidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "field": {
                "type": "string"
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "evidence": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "field",
              "confidence",
              "evidence"
            ]
          }
        },
        "missingFields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "imageIssues": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "DARK",
              "BLURRY",
              "ROTATED",
              "PERSPECTIVE",
              "CROPPED",
              "LOW_CONTRAST",
              "OVERLAPPING_DOCUMENT",
              "HANDWRITING_OVER_TEXT",
              "OTHER"
            ]
          }
        }
      },
      "required": [
        "overallConfidence",
        "fieldConfidence",
        "missingFields",
        "warnings",
        "imageIssues"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "documentType",
    "document",
    "weights",
    "pricing",
    "deductions",
    "notes",
    "quality"
  ]
}